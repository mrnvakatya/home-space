# Скопируйте этот файл в .env и поменяйте значения. Файл .env в git не попадает.

# SQLite по умолчанию (ничего устанавливать не нужно).
DATABASE_URL=sqlite:///./homespace.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/homespace

# Секрет для подписи cookie-сессий. В продакшене задайте длинную случайную строку.
SECRET_KEY=change-me-please
